# ==============================================================================
# Lapian Notes - Конфигурация API ключей для прямого подключения к AI (BYOK)
# ==============================================================================
# Скопируйте этот файл в .env и укажите ваши ключи.
# Поддерживаются как переменные без префикса (MINIMAX_API_KEY),
# так и с префиксом Vite (VITE_MINIMAX_API_KEY).
# ==============================================================================

# MiniMax (https://platform.minimax.io / https://platform.minimaxi.com)
MINIMAX_API_KEY=
VITE_MINIMAX_API_KEY=

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Moonshot Kimi (https://platform.moonshot.cn/)
KIMI_API_KEY=
VITE_KIMI_API_KEY=

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
CLAUDE_API_KEY=
VITE_CLAUDE_API_KEY=
